# RTSP Stream Simulator - Default Configuration
# Modify these values to customize the simulated RTSP stream.

# Path to the MP4 file to stream (used with file profile)
RTSP_INPUT=./sample.mp4

# RTSP server port
RTSP_PORT=8554

# USB camera device path (used with camera profile)
CAMERA_DEVICE=/dev/video0
CAMERA_FRAMERATE=30
CAMERA_RESOLUTION=1280x720

