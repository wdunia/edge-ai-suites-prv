{
  "vlmDevice": "gpu",
  "pipelineType": "non-detection",
  "cameraDevice": "/dev/video0",
  "runs": [
    {
      "runName": "USB-Camera",
      "source": "camera",
      "prompt": "You are a fire safety monitor watching a room. Is there any fire hazard visible?",
      "maxNewTokens": 15,
      "frameRate": 1,
      "chunkSize": 1
    },
    {
      "runName": "Intersection",
      "source": "file",
      "prompt": "Is there a cyclist and where is it? Describe in less than 15 words.",
      "maxNewTokens": 20,
      "frameRate": 1,
      "chunkSize": 1,
      "frameWidth": 640,
      "frameHeight": 480
    },
    {
      "runName": "Dashcam1",
      "source": "file",
      "prompt": "Is there a car accident visible? Describe in less than 15 words.",
      "maxNewTokens": 20,
      "frameRate": 1,
      "chunkSize": 1,
      "frameWidth": 640,
      "frameHeight": 480
    },
    {
      "runName": "Dashcam2",
      "source": "file",
      "prompt": "Is there a car accident visible? Describe in less than 15 words.",
      "maxNewTokens": 20,
      "frameRate": 1,
      "chunkSize": 1,
      "frameWidth": 640,
      "frameHeight": 480
    }
  ]
}
