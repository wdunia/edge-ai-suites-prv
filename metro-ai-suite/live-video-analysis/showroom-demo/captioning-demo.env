#
# Showroom overrides for live-video-captioning.
# Applied on top of live-video-captioning/.env:
#   docker compose --env-file ../live-video-captioning/.env --env-file captioning-demo.env ...
# Never put credentials or tokens in this file.

# Docker image configuration
REGISTRY=intel/
TAG=latest

# Compose project name (keeps showroom containers separate from manual runs)
PROJECT_NAME=live-captioning

# Showroom features: alert highlighting on, object detection off
ALERT_MODE=true
ENABLE_DETECTION_PIPELINE=false
CAPTION_HISTORY=3

# WebRTC bitrate (kbps) - lower it if the showroom network is constrained
WEBRTC_BITRATE=2048

# KV-cache size passed to gvagenai (scheduler-config cache_size), default 4.
# Each run loads its own VLM instance - the pipelines do not share the model -
# so lower it only if the concurrent streams no longer fit into GPU memory.
VLM_CACHE_SIZE=4

# The dashboard is driven by run-pipelines.sh, so no pre-filled URL is needed.
DEFAULT_RTSP_URL=

